{
  "name": "swiftstream",
  "version": "0.1.7",
  "description": "Terminal and fast, resumable file transfer for your servers: sign in over SSH once, then everything goes over HTTPS on parallel connections.",
  "keywords": [
    "ssh",
    "sftp",
    "scp",
    "file-transfer",
    "remote-shell",
    "deploy",
    "cli",
    "https"
  ],
  "homepage": "https://github.com/Kaeden-Martinson/Swiftstream#readme",
  "bugs": {
    "url": "https://github.com/Kaeden-Martinson/Swiftstream/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaeden-Martinson/Swiftstream.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "swiftstream": "bin/swiftstream.js",
    "sws": "bin/swiftstream.js"
  },
  "files": [
    "bin",
    "src",
    "dist/swiftstream.cjs",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node test/e2e.js && node test/sshconfig.js && node test/bootstrap.js",
    "app": "npm --prefix app start",
    "app:dist": "npm --prefix app run dist",
    "build": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "publish-site": "node scripts/publish-site.mjs",
    "prepack": "node scripts/build.mjs --no-exe",
    "test:package": "node test/package.js",
    "test:app": "node test/app/run.js"
  },
  "dependencies": {
    "selfsigned": "^2.4.1",
    "ssh2": "^1.17.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}

{
  "name": "swiftssh",
  "version": "0.1.0",
  "description": "Fast, loss-tolerant remote shell and file transfer over HTTPS with SSH-style key auth",
  "type": "module",
  "bin": {
    "swiftssh": "bin/swiftssh.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node test/e2e.js && node test/bootstrap.js",
    "app": "npm --prefix app start",
    "app:dist": "npm --prefix app run dist",
    "build": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "publish-site": "node scripts/publish-site.mjs"
  },
  "dependencies": {
    "selfsigned": "^2.4.1",
    "ssh2": "^1.17.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}

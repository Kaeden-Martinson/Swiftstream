{
  "name": "swiftstream-desktop",
  "productName": "Swiftstream",
  "version": "0.1.4",
  "description": "Desktop app for swiftstream: fast remote shell and file transfer over HTTPS",
  "type": "module",
  "main": "main.js",
  "private": true,
  "scripts": {
    "sync-core": "node scripts/sync-core.js",
    "start": "npm run sync-core && electron .",
    "dist": "npm run sync-core -- --for-installer && node scripts/make-installer.js && electron-builder --win --publish never",
    "icon": "electron scripts/make-icon.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "selfsigned": "^2.4.1",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "author": {
    "name": "Swiftstream",
    "email": "Kaeden-Martinson@users.noreply.github.com"
  },
  "build": {
    "appId": "dev.swiftstream.desktop",
    "productName": "Swiftstream",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "log.js",
      "preload.cjs",
      "renderer/**",
      "core/**",
      "build/icon.png",
      "build/icon.ico",
      "!**/*.map",
      "!node_modules/cpu-features{,/**}",
      "!node_modules/ssh2/lib/protocol/crypto/build{,/**}"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Swiftstream",
      "artifactName": "Swiftstream-Setup-${version}.exe",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "artifactName": "Swiftstream-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "Fast remote shell and file transfer for your servers",
      "maintainer": "Swiftstream <Kaeden-Martinson@users.noreply.github.com>"
    },
    "extraResources": [
      {
        "from": "build/cli",
        "to": "cli",
        "filter": [
          "swiftstream.exe",
          "sws.cmd"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Kaeden-Martinson",
        "repo": "Swiftstream"
      }
    ],
    "dmg": {
      "artifactName": "Swiftstream-${version}-mac.${ext}"
    },
    "appImage": {
      "artifactName": "Swiftstream-${version}-linux-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "Swiftstream-${version}-linux-amd64.${ext}"
    }
  },
  "homepage": "https://github.com/Kaeden-Martinson/Swiftstream"
}
